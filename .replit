modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["stripe:1.0.0", "python_openai_ai_integrations:1.0.0", "google-mail:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "portaudio", "rustc", "xsimd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "THE VOID ENGINE"

[[workflows.workflow]]
name = "THE VOID ENGINE"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8099
externalPort = 8099

[userenv]

[userenv.shared]
FOUNDER_USERNAME = "adriana"
VOID_PUBLIC_URL = "https://void-stego-engine.replit.app"

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind=0.0.0.0:5000", "--reuse-port", "--workers=2", "app:app"]
build = ["bash", "-c", "pip install -r requirements.txt && python scripts/migrate.py"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
