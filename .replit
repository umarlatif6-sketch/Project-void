modules = ["python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["stripe:1.0.0", "python_openai_ai_integrations:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["cargo", "libiconv", "libxcrypt", "openssl", "pkg-config", "rustc", "xsimd"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "THE VOID ENGINE"

[[workflows.workflow]]
name = "THE VOID ENGINE"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python app.py"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5904
externalPort = 80

[[ports]]
localPort = 8099
externalPort = 8099

[userenv]

[userenv.shared]
FOUNDER_USERNAME = "adriana"

[deployment]
deploymentTarget = "autoscale"
run = ["gunicorn", "--bind=0.0.0.0:5904", "--timeout=120", "--workers=2", "--reuse-port", "--preload", "app:app"]
build = ["pip", "install", "-r", "requirements.txt"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 60000
