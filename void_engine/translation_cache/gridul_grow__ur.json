{"slug": "/gridul/grow", "lang": "ur", "hash": "1d82f1a5af1cf4cd", "translated": "<div class=\"zones-grid\" id=\"zones-grid\">\n            \n\n            \n            <div class=\"zone-add-card\" onclick=\"openAddZone()\">\n                <div class=\"zone-add-icon\">+</div>\n                <div class=\"zone-add-label\">نئی بڑھتی ہوئی زون شامل کریں</div>\n                <div class=\"zone-add-sub\">0/3 زون استعمال ہوئے</div>\n            </div>\n            \n        </div>\n\n        \n        <div style=\"text-align:center; color:#333; font-size:0.72rem; margin-top:-24px;\">\n            ابھی تک کوئی زون نہیں ہیں۔ اپنا پہلا بڑھتا ہوا زون بنانے کے لیے اوپر والے کارڈ پر کلک کریں۔\n        </div>\n        \n\n        <!-- PEACE SESSION TRACKER -->\n        <section class=\"peace-section\">\n            <div class=\"peace-section-header\">\n                <span class=\"peace-section-title\">▪ PEACE ٹوکن کمائیں</span>\n                \n                <span style=\"font-size:0.6rem;letter-spacing:2px;color:#444;text-transform:uppercase;\">Genesis 10 کی ضرورت ہے</span>\n                \n            </div>\n\n            \n            <div style=\"padding: 32px 0; text-align: center;\">\n                <div style=\"font-size: 1.6rem; margin-bottom: 14px; color: #1e1e1e;\">▮</div>\n                <div style=\"font-size: 0.72rem; letter-spacing: 2px; color: #444; text-transform: uppercase; margin-bottom: 10px;\">سویورین نوڈ تک رسائی درکار ہے</div>\n                <p style=\"font-size: 0.68rem; color: #333; max-width: 380px; margin: 0 auto 20px; line-height: 1.8;\">\n                    PEACE ٹوکن کی منٹینگ صرف Genesis 10 Blueprint NFT کے حاملین کے لیے دستیاب ہے —\n                    VOID معیشت کے بانی حیاتیاتی میش نوڈز۔\n                </p>\n                <a href=\"/genesis\" style=\"display:inline-block;background:transparent;border:1px solid #2a2a2a;border-radius:4px;padding:9px 28px;font-family:inherit;font-size:0.68rem;letter-spacing:2px;color:#555;text-transform:uppercase;text-decoration:none;transition:border-color 0.15s,color 0.15s;\" onmouseover=\"this.style.borderColor='#4caf50';this.style.color='#4caf50';\" onmouseout=\"this.style.borderColor='#2a2a2a';this.style.color='#555';\">\n                    Genesis 10 NFTs دیکھیں\n                </a>\n            </div>\n            \n        </section>"}