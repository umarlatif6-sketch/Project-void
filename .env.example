# Project VOID Environment Configuration
# Copy this file to .env and fill in your actual values

# Required: Flask session secret (generate a random string)
SESSION_SECRET=supersecretreplacewithreal

# Required: PostgreSQL database URL
# Local host example:
DATABASE_URL=postgresql://user:password@localhost:5432/void_db
# Docker Compose example:
# DATABASE_URL=postgresql://void:void@db:5432/void_db
# If your normal local DATABASE_URL points somewhere else, Docker can use this override:
DOCKER_DATABASE_URL=postgresql://void:void@db:5432/void_db

# Optional: OpenAI API for AI integrations
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Alternative OpenAI key (fallback)
OPENAI_API_KEY=

# Optional: Stripe for payments
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: ElevenLabs for voice synthesis
ELEVENLABS_API_KEY=

# Optional: Unified TTS provider routing
# auto (default), openai, elevenlabs, elevenlabs_oss
TTS_PROVIDER=auto

# OpenAI-compatible TTS options
TTS_OPENAI_MODEL=tts-1
TTS_OPENAI_VOICE=alloy

# ElevenLabs-compatible options (cloud or self-hosted)
# Example self-hosted: http://127.0.0.1:5001/v1
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Default fallback voice id for ElevenLabs-compatible providers
TTS_ELEVENLABS_VOICE=

# Optional: Google AI (Gemini)
GOOGLE_AI_API_KEY=

# Optional: Google Earth Engine
# Service-account mode (recommended for servers)
GEE_PROJECT=
GEE_SERVICE_ACCOUNT=
# Paste private key exactly as provided (\n escapes are supported)
GEE_PRIVATE_KEY=
# Alternative to GEE_PRIVATE_KEY: absolute path to JSON/PEM key file
GEE_PRIVATE_KEY_FILE=
# Set true to use local gcloud/earthengine auth instead of service-account env vars
GEE_USE_DEFAULT_AUTH=false
# Internal synthesis token budget for Adriana in GEE orchestration endpoint
ADRIANA_INTERNAL_LLM_MAX_TOKENS=1200

# Optional: Hugging Face for ML models
HUGGINGFACE_API_KEY=

# Optional: Replit-specific (if deploying there)
REPLIT_DOMAINS=localhost:5000
REPLIT_CONNECTORS_HOSTNAME=
REPL_IDENTITY=
WEB_REPL_RENEWAL=

# Optional: Myco simulation profile
MYCO_SIM_PROFILE=default

# Optional: Port for local development / Docker port bind
PORT=5000

# Optional: Docker Compose Postgres defaults
POSTGRES_DB=void_db
POSTGRES_USER=void
POSTGRES_PASSWORD=void
POSTGRES_PORT=5432
PROXY_PORT=8080

# Packet Security (recommended for production)
# Enforce fail-closed startup if packet security vars are incomplete.
VOID_PACKET_SECURITY_ENFORCE=false

# Active signing key id and private key (Ed25519 raw hex or PEM)
VOID_PACKET_SIGNING_KEY_ID=default
VOID_PACKET_SIGNING_PRIVATE_KEY=

# Verification keyring used by packet resolve (JSON object: {"key_id":"public_key"})
VOID_PACKET_VERIFY_KEYS_JSON={}

# Require sector policy presence and set replay window (seconds)
VOID_PACKET_REQUIRE_SECTOR_POLICY=false
VOID_PACKET_MAX_AGE_SECONDS=86400
